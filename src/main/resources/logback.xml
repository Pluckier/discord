<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Configure the CONSOLE output channel -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- This pattern adds colors (%highlight) and formats timestamps and threads nicely -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %highlight(%-5level) %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set the default log level for your whole bot application -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>